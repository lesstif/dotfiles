alias wp='cd /var/www/wordpress/wordpress-latest/'

alias gi-java="gi \"eclipse,java,vim,maven,windows,intellij\""
alias gi-laravel="gi \"php,linux,vim,composer,windows,phpstorm,laravel\""
alias h='http --follow'
alias cls='clear'

## application log
MY_WAS=${MY_WAS:-"$HOME/apache-tomcat-7.0.53"}
alias lv='tail -f "$MY_WAS/logs/catalina.out"'
alias lvi='vim "$MY_WAS/logs/catalina.out"'

CONFLUENCE_DIR=${CONFLUENCE_DIR:-/var/atlassian/confluence}
alias clv='tail -f "$CONFLUENCE_DIR/confluence-app-data/confluence/logs/atlassian-confluence.log"'
alias clvi='vim "$CONFLUENCE_DIR/confluence-app-data/confluence/logs/atlassian-confluence.log"'

# Easier navigation: .., ..., ...., ....., ~ and -
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias '~'='cd ~' # `cd` is probably faster to type though
alias -- -="cd -"

# Shortcuts
alias d="cd ~/Documents/Dropbox"
alias dl="cd ~/Downloads"
alias dt="cd ~/Desktop"
alias p="cd ~/projects"
alias g="git"

# Detect which `ls` flavor is in use
if (( $+commands[gls] )); then
    alias ls='gls --color=auto'
elif command ls --color=auto -d . >/dev/null 2>&1; then
    alias ls='ls --color=auto'
else
    alias ls='ls -G'
fi

# List all files colorized in long format
alias l="ls -lF"

# List all files colorized in long format, including dot files
alias la="ls -laF"

# List only directories
alias lsd="ls -lF | grep --color=never '^d'"

# Always use color output for `ls`

# Always enable colored `grep` output
# Note: `GREP_OPTIONS="--color=auto"` is deprecated, hence the alias usage.
##alias grep='grep --color=auto -d'
##alias fgrep='fgrep --color=auto -d'
##alias egrep='egrep --color=auto -d'

# Enable aliases to be sudo’ed
alias sudo='sudo '

# Get week number
alias week='date +%V'

# Google Chrome

# IP addresses
## alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
alias ips="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Show active network interfaces

# Canonical hex dump; some systems have this symlinked
command -v hd > /dev/null || alias hd="hexdump -C"

# URL-encode strings
alias urlencode='python3 -c "import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]));"'

# Intuitive map function
# For example, to list all directories that contain a certain file:
# find . -name .gitattributes | map dirname
alias map="xargs -n1"

# One of @janmoesen’s ProTip™s
for method in GET HEAD POST PUT DELETE TRACE OPTIONS; do
	alias "${method}"="lwp-request -m '${method}'"
done

# Make Grunt print stack traces by default
command -v grunt > /dev/null && alias grunt="grunt --stack"

# Kill all the tabs in Chrome to free up memory
