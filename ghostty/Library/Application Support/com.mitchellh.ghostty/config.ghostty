# The syntax is "key = value". The whitespace around the
# equals doesn't matter.
background = 282c34
foreground = ffffff

# Comments start with a `#` and are only valid on their own line.
# Blank lines are ignored!

keybind = ctrl+z=close_surface
#keybind = ctrl+d=new_split:right

## for Ctrl-D works as delete char
keybind = ctrl+d=text:\x04
#keybind = ctrl+d=unbind

#keybind = ctrl+physical:d=unbind

# Empty values reset the configuration to the default value
font-family = "JetBrains Mono"
font-size = 20

# cursor-color 를 아예 지정하지 않거나, 지정하려면 동적으로 따라가게
cursor-color = cell-foreground

# 셸 통합이 프롬프트에서 커서 모양/색을 강제로 바꾸는 걸 방지
shell-integration-features = no-cursor